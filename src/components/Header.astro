---
interface Props {
  brand?: string;
  logo?: string | null;
}

const { brand = 'LUIZA TINOCO', logo } = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/projetos', label: 'Projetos' },
  { href: '/sobre', label: 'Sobre' },
  { href: '/contato', label: 'Contato' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="header">
  <div class="container">
    <a href="/" class="logo" aria-label={brand}>
      {
        logo ? (
          <img src={logo} alt={brand} class="logo-img" />
        ) : (
          brand
        )
      }
    </a>
    <nav>
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={['label', 'nav-link', { current: isCurrent(link.href) }]}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background 200ms var(--ease-out),
      border-color 200ms var(--ease-out);
  }

  .header--visible {
    background: rgba(250, 250, 250, 0.9);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-bottom: 1px solid rgba(214, 214, 214, 0.3);
  }

  .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 80rem;
    margin-inline: auto;
    padding: 2rem 5rem;
  }

  .logo {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.4;
    color: var(--ink);
  }

  .logo-img {
    display: block;
    max-height: 2.5rem;
    width: auto;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-link {
    position: relative;
    padding: 0.5rem 0 4px;
    color: var(--body-color);
    border-bottom: 1px solid transparent;
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    inset: -12px -10px;
  }

  .nav-link:hover,
  .nav-link.current {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  @media (max-width: 64rem) {
    .container {
      padding: 1.25rem 1.5rem;
    }

    nav {
      gap: 1.25rem;
    }
  }

  @media (max-width: 30rem) {
    .container {
      flex-direction: column;
      gap: 0.25rem;
      padding: 1rem 1rem 0.75rem;
    }

    .logo {
      font-size: 1.375rem;
    }

    nav {
      gap: 1.5rem;
    }
  }
</style>
