---
interface Props {
  brand?: string;
  logo?: string | null;
  topoTransparente?: boolean;
}

const {
  brand = 'LUIZA TINOCO',
  logo,
  topoTransparente = false,
} = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/projetos', label: 'Projetos' },
  { href: '/galeria', label: 'Galeria' },
  { href: '/sobre', label: 'Sobre' },
  { href: '/contato', label: 'Contato' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header
  class:list={[
    'header',
    {
      'header--topo-transparente': topoTransparente,
      'header--visible': !topoTransparente,
    },
  ]}
>
  <div class="container">
    <a href="/" class="logo" aria-label={brand}>
      {
        logo ? (
          <>
            <img src={logo} alt={brand} class="logo-img" />
            <img
              src={logo.replace(/\.svg$/, '-branco.svg')}
              alt=""
              aria-hidden="true"
              class="logo-img logo-img--branca"
            />
          </>
        ) : (
          brand
        )
      }
    </a>
    <nav id="menu-mobile">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={['label', 'nav-link', { current: isCurrent(link.href) }]}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <button
      type="button"
      class="hamburger"
      aria-expanded="false"
      aria-controls="menu-mobile"
      aria-label="Abrir menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
  }

  .header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(250, 250, 250, 0.9);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-bottom: 1px solid rgba(214, 214, 214, 0.3);
    box-shadow: 0 1px 8px rgba(12, 12, 12, 0.04);
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 280ms var(--ease-out),
      transform 280ms var(--ease-out);
  }

  .header--topo-transparente::before {
    opacity: 0;
    transform: translateY(-8px);
  }

  .header--topo-transparente.header--visible::before {
    opacity: 1;
    transform: translateY(0);
  }

  .container {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 80rem;
    margin-inline: auto;
    padding: 2rem 5rem;
  }

  .logo {
    position: relative;
    display: block;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.4;
    color: var(--ink);
    transition: color 240ms var(--ease-out);
  }

  .logo-img {
    display: block;
    max-height: 2.5rem;
    width: auto;
    transition: opacity 240ms var(--ease-out);
  }

  .logo-img--branca {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: auto;
    opacity: 0;
  }

  .header--topo-transparente .logo {
    color: #fff;
  }

  .header--topo-transparente.header--visible .logo {
    color: var(--ink);
  }

  .header--topo-transparente .logo-img:not(.logo-img--branca) {
    opacity: 0;
  }

  .header--topo-transparente.header--visible .logo-img:not(.logo-img--branca) {
    opacity: 1;
  }

  .header--topo-transparente .logo-img--branca {
    opacity: 1;
  }

  .header--topo-transparente.header--visible .logo-img--branca {
    opacity: 0;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  /* Hamburger (só mobile) */
  .hamburger {
    display: none;
    position: relative;
    z-index: 2;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 44px;
    height: 44px;
    padding: 0 10px;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--ink);
    transition: color 240ms var(--ease-out);
  }

  .hamburger span {
    display: block;
    width: 100%;
    height: 1.5px;
    background: currentColor;
    transition:
      transform 250ms var(--ease-out),
      opacity 200ms ease;
  }

  .hamburger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7.5px) rotate(45deg);
  }

  .hamburger[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }

  .hamburger[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7.5px) rotate(-45deg);
  }

  .header--topo-transparente .hamburger {
    color: #fff;
  }

  .header--topo-transparente.header--visible .hamburger {
    color: var(--ink);
  }

  @media (max-width: 48rem) {
    .container {
      padding: 1.25rem 1.5rem;
    }

    .hamburger {
      display: inline-flex;
    }

    nav {
      position: fixed;
      inset: 0;
      z-index: 1;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8rem 2.5rem 2rem;
      background: var(--bg);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition:
        opacity 250ms var(--ease-out),
        transform 250ms var(--ease-out),
        visibility 0s 250ms;
    }

    .header.menu-aberto nav {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition:
        opacity 250ms var(--ease-out),
        transform 250ms var(--ease-out);
    }

    nav .nav-link {
      font-size: 1.125rem;
      padding: 1.25rem 0;
      color: var(--ink);
      border-bottom: 1px solid var(--accent);
    }

    nav .nav-link::after {
      inset: -4px 0;
    }

    nav .nav-link:hover,
    nav .nav-link.current {
      color: var(--ink);
      border-bottom-color: var(--ink);
    }
  }

  .nav-link {
    position: relative;
    padding: 0.5rem 0 4px;
    color: var(--body-color);
    border-bottom: 1px solid transparent;
    transition:
      color 240ms var(--ease-out),
      border-color 240ms var(--ease-out);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    inset: -12px -10px;
  }

  .nav-link:hover,
  .nav-link.current {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  .header--topo-transparente .nav-link {
    color: rgba(255, 255, 255, 0.85);
    border-bottom-color: transparent;
  }

  .header--topo-transparente .nav-link:hover,
  .header--topo-transparente .nav-link.current {
    color: #fff;
    border-bottom-color: #fff;
  }

  .header--topo-transparente.header--visible .nav-link {
    color: var(--body-color);
    border-bottom-color: transparent;
  }

  .header--topo-transparente.header--visible .nav-link:hover,
  .header--topo-transparente.header--visible .nav-link.current {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .header::before,
    .logo,
    .logo-img,
    .hamburger span,
    nav {
      transition: none;
    }
  }
</style>

<script>
  function initMenu() {
    const botao = document.querySelector('.hamburger');
    const menu = document.getElementById('menu-mobile');
    const headerEl = botao?.closest('.header');
    if (!botao || !menu || !headerEl || botao.dataset.menuBound) return;
    botao.dataset.menuBound = '1';

    const fechar = () => {
      menu.classList.remove('aberto');
      headerEl.classList.remove('menu-aberto');
      botao.setAttribute('aria-expanded', 'false');
      botao.setAttribute('aria-label', 'Abrir menu');
      document.documentElement.style.overflow = '';
      if (
        headerEl.classList.contains('header--topo-transparente') &&
        window.scrollY <= 40
      ) {
        headerEl.classList.remove('header--visible');
      }
    };

    botao.addEventListener('click', () => {
      const aberto = menu.classList.toggle('aberto');
      headerEl.classList.toggle('menu-aberto', aberto);
      botao.setAttribute('aria-expanded', String(aberto));
      botao.setAttribute('aria-label', aberto ? 'Fechar menu' : 'Abrir menu');
      document.documentElement.style.overflow = aberto ? 'hidden' : '';
      if (aberto) headerEl.classList.add('header--visible');
      else fechar();
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', fechar);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') fechar();
    });

    window
      .matchMedia('(min-width: 48rem)')
      .addEventListener('change', (e) => {
        if (e.matches) fechar();
      });
  }

  document.addEventListener('astro:page-load', initMenu);
</script>
