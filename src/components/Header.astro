---
interface Props {
  brand?: string;
  logo?: string | null;
  topoTransparente?: boolean;
}

const {
  brand = 'LUIZA TINOCO',
  logo,
  topoTransparente = false,
} = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/projetos', label: 'Projetos' },
  { href: '/sobre', label: 'Sobre' },
  { href: '/contato', label: 'Contato' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header
  class:list={[
    'header',
    {
      'header--topo-transparente': topoTransparente,
      'header--visible': !topoTransparente,
    },
  ]}
>
  <div class="container">
    <a href="/" class="logo" aria-label={brand}>
      {
        logo ? (
          <>
            <img src={logo} alt={brand} class="logo-img" />
            <img
              src={logo.replace(/\.svg$/, '-branco.svg')}
              alt=""
              aria-hidden="true"
              class="logo-img logo-img--branca"
            />
          </>
        ) : (
          brand
        )
      }
    </a>
    <nav>
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={['label', 'nav-link', { current: isCurrent(link.href) }]}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
  }

  .header::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(250, 250, 250, 0.9);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-bottom: 1px solid rgba(214, 214, 214, 0.3);
    box-shadow: 0 1px 8px rgba(12, 12, 12, 0.04);
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 280ms var(--ease-out),
      transform 280ms var(--ease-out);
  }

  .header--topo-transparente::before {
    opacity: 0;
    transform: translateY(-8px);
  }

  .header--topo-transparente.header--visible::before {
    opacity: 1;
    transform: translateY(0);
  }

  .container {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 80rem;
    margin-inline: auto;
    padding: 2rem 5rem;
  }

  .logo {
    position: relative;
    display: block;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.4;
    color: var(--ink);
    transition: color 240ms var(--ease-out);
  }

  .logo-img {
    display: block;
    max-height: 2.5rem;
    width: auto;
    transition: opacity 240ms var(--ease-out);
  }

  .logo-img--branca {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: auto;
    opacity: 0;
  }

  .header--topo-transparente .logo {
    color: #fff;
  }

  .header--topo-transparente.header--visible .logo {
    color: var(--ink);
  }

  .header--topo-transparente .logo-img:not(.logo-img--branca) {
    opacity: 0;
  }

  .header--topo-transparente.header--visible .logo-img:not(.logo-img--branca) {
    opacity: 1;
  }

  .header--topo-transparente .logo-img--branca {
    opacity: 1;
  }

  .header--topo-transparente.header--visible .logo-img--branca {
    opacity: 0;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-link {
    position: relative;
    padding: 0.5rem 0 4px;
    color: var(--body-color);
    border-bottom: 1px solid transparent;
    transition:
      color 240ms var(--ease-out),
      border-color 240ms var(--ease-out);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    inset: -12px -10px;
  }

  .nav-link:hover,
  .nav-link.current {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  .header--topo-transparente .nav-link {
    color: rgba(255, 255, 255, 0.85);
    border-bottom-color: transparent;
  }

  .header--topo-transparente .nav-link:hover,
  .header--topo-transparente .nav-link.current {
    color: #fff;
    border-bottom-color: #fff;
  }

  .header--topo-transparente.header--visible .nav-link {
    color: var(--body-color);
    border-bottom-color: transparent;
  }

  .header--topo-transparente.header--visible .nav-link:hover,
  .header--topo-transparente.header--visible .nav-link.current {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .header::before,
    .logo,
    .logo-img {
      transition: none;
    }
  }

  @media (max-width: 64rem) {
    .container {
      padding: 1.25rem 1.5rem;
    }

    nav {
      gap: 1.25rem;
    }
  }

  @media (max-width: 30rem) {
    .container {
      flex-direction: column;
      gap: 0.25rem;
      padding: 1rem 1rem 0.75rem;
    }

    .logo {
      font-size: 1.375rem;
    }

    nav {
      gap: 1.5rem;
    }
  }
</style>
