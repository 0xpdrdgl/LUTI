<header class="header">
  <div class="container">
    <a href="/" class="logo" aria-label={brand}>
      {
        logo ? (
          <img src={logo} alt={brand} class="logo-img" />
        ) : (
          brand
        )
      }
    </a>
    <nav>
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={['label', 'nav-link', { current: isCurrent(link.href) }]}
            aria-current={isCurrent(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    background: transparent;
    border-bottom: 1px solid transparent;
    transition:
      background 200ms var(--ease-out),
      border-color 200ms var(--ease-out),
      transform 300ms var(--ease-out),
      opacity 300ms var(--ease-out);
    transform: translateY(-100%);
    opacity: 0;
  }

  .header--loaded {
    transform: translateY(0);
    opacity: 1;
  }

  .header--visible {
    background: rgba(250, 250, 250, 0.9);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border-bottom: 1px solid rgba(214, 214, 214, 0.3);
  }

  .header:not(.header--visible) .logo,
  .header:not(.header--visible) .nav-link {
    color: #fff;
  }

  .header:not(.header--visible) .nav-link:hover,
  .header:not(.header--visible) .nav-link.current {
    color: #fff;
    border-bottom-color: #fff;
  }

  .header--visible .logo,
  .header--visible .nav-link {
    color: var(--ink);
  }

  .header--visible .nav-link:hover,
  .header--visible .nav-link.current {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 80rem;
    margin-inline: auto;
    padding: 2rem 5rem;
  }

  .logo {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.4;
    transition: color 200ms var(--ease-out);
  }

  .logo-img {
    display: block;
    max-height: 2.5rem;
    width: auto;
    transition: opacity 200ms var(--ease-out);
  }

  nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-link {
    position: relative;
    padding: 0.5rem 0 4px;
    color: var(--body-color);
    border-bottom: 1px solid transparent;
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    inset: -12px -10px;
  }

  .nav-link:hover,
  .nav-link.current {
    border-bottom-color: var(--ink);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    inset: -12px -10px;
  }

  @media (max-width: 64rem) {
    .container {
      padding: 1.25rem 1.5rem;
    }

    nav {
      gap: 1.25rem;
    }
  }

  @media (max-width: 30rem) {
    .container {
      flex-direction: column;
      gap: 0.25rem;
      padding: 1rem 1rem 0.75rem;
    }

    .logo {
      font-size: 1.375rem;
    }

    nav {
      gap: 1.5rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.querySelector('.header');
    if (!header) return;

    // Animação de entrada do header
    requestAnimationFrame(() => {
      header.classList.add('header--loaded');
    });

    const hero = document.querySelector('.hero');
    if (!hero) return;

    const showHeader = () => {
      if (window.scrollY > 50) {
        header.classList.add('header--visible');
      } else {
        header.classList.remove('header--visible');
      }
    };

    window.addEventListener('scroll', showHeader, { passive: true });
    showHeader();
  });
</script>
