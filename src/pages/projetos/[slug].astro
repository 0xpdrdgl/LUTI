---
import PageLayout from '../../layouts/PageLayout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../../keystatic.config';
import { projetosImage } from '../../lib/images';

export async function getStaticPaths() {
  const projetos = await createReader(
    process.cwd(),
    keystaticConfig,
  ).collections.projetos.all();

  return projetos.map(({ slug, entry }) => ({
    params: { slug },
    props: { projeto: entry },
  }));
}

const { projeto } = Astro.props;

const galeria = (projeto.galeria ?? []).map((img) => projetosImage(img));
---

<PageLayout title={`${projeto.titulo} — LUIZA TINOCO`} description={projeto.resumo}>
  <article class="projeto-detalhe">
    <a href="/projetos" class="label voltar">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M14 8H3M7 3.5 2.5 8 7 12.5" stroke="currentColor"></path>
      </svg>
      VOLTAR
    </a>

    <header class="projeto-header">
      <div class="projeto-meta">
        <span class="label">{projeto.categoria}</span>
        {projeto.ano && <span class="label">{projeto.ano}</span>}
      </div>
      <h1>{projeto.titulo}</h1>
      {projeto.resumo && <p class="projeto-resumo">{projeto.resumo}</p>}
    </header>

    <div class="projeto-galeria">
      <figure class="projeto-capa">
        <img src={projetosImage(projeto.capa)} alt={projeto.titulo} />
      </figure>

      {
        galeria.length > 0 && (
          <div class="projeto-thumbs">
            {galeria.map((img, i) => (
              <figure class="projeto-thumb">
                <img src={img} alt={`${projeto.titulo} - vista ${i + 1}`} loading="lazy" />
              </figure>
            ))}
          </div>
        )
      }
    </div>

    {
      projeto.descricao && (
        <div class="projeto-descricao">
          <p>{projeto.descricao}</p>
        </div>
      )
    }
  </article>
</PageLayout>

<style>
  .projeto-detalhe {
    max-width: 80rem;
    margin-inline: auto;
    padding: 4rem 5rem 5rem;
  }

  .voltar {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.5rem 0.5rem 0;
    color: var(--muted);
    transition: color 200ms var(--ease-out);
  }

  .voltar svg {
    transition: transform 200ms var(--ease-out);
  }

  .voltar:hover {
    color: var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .voltar:hover svg {
      transform: translateX(-4px);
    }
  }

  .projeto-header {
    margin-bottom: 4rem;
  }

  .projeto-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .projeto-meta .label {
    color: var(--muted);
  }

  .projeto-header h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ink);
    max-width: 30ch;
  }

  .projeto-resumo {
    margin-top: 1.5rem;
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--body-color);
    max-width: 45ch;
  }

  .projeto-galeria {
    margin-bottom: 5rem;
  }

  .projeto-capa {
    margin-bottom: 2rem;
  }

  .projeto-capa img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  .projeto-thumbs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .projeto-thumb img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
    transition: transform 300ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .projeto-thumb img:hover {
      transform: scale(1.02);
    }
  }

  .projeto-descricao {
    max-width: 45ch;
  }

  .projeto-descricao p {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--body-color);
    white-space: pre-line;
  }

  @media (max-width: 64rem) {
    .projeto-detalhe {
      padding-inline: 1.5rem;
    }
  }
</style>
