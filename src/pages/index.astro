---
import PageLayout from '../layouts/PageLayout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { projetosImage, siteImage } from '../lib/images';

const reader = createReader(process.cwd(), keystaticConfig);
const home = await reader.singletons.home.read();
const projetos = await reader.collections.projetos.all();

// Projetos marcados como "Destacar na home" aparecem primeiro; se tiver
// menos de 3 marcados, completa com os demais pra sempre mostrar 3.
const destacados = projetos.filter(({ entry }) => entry.destaque);
const outros = projetos.filter(({ entry }) => !entry.destaque);

const recentes = [...destacados, ...outros]
  .slice(0, 3)
  .map(({ slug, entry }) => ({
    slug,
    titulo: entry.titulo,
    capa: projetosImage(entry.capa),
  }));

const frase = home?.faixaFrase ?? '';
const ultimoEspaco = frase.lastIndexOf(' ');
const fraseInicio = ultimoEspaco > 0 ? frase.slice(0, ultimoEspaco) : frase;
const fraseFim = ultimoEspaco > 0 ? frase.slice(ultimoEspaco + 1) : '';

// Depoimentos variam de ~35 a ~260 palavras: normaliza espaços, quebra em
// parágrafos e deixa o card truncar os longos (texto completo abre em dialog).
const depoimentos = (home?.depoimentos ?? [])
  .map((dep) => ({
    nome: dep.nome?.trim() ?? '',
    relacao: dep.relacao?.trim() ?? '',
    paragrafos: (dep.texto ?? '')
      .split(/\n\s*\n/)
      .map((p) => p.replace(/\s+/g, ' ').trim())
      .filter(Boolean),
  }))
  .filter((dep) => dep.paragrafos.length > 0);
---

<PageLayout title="LUIZA TINOCO — Arquitetura" fullBleed>
  <section class="hero">
    <img
      src={home?.heroImagem ? siteImage(home.heroImagem) ?? '/images/hero.webp' : '/images/hero.webp'}
      alt=""
      class="hero-image"
    />
    <div class="hero-overlay"></div>
    <div class="hero-content" data-reveal>
      <h1>{home?.heroTitulo}</h1>
      {home?.projetosNota && <p class="label hero-nota">{home.projetosNota}</p>}
      <a href={home?.heroBotaoHref ?? '/projetos'} class="label hero-link">
        {home?.heroBotaoLabel}
      </a>
    </div>
    <div class="scroll-hint" aria-hidden="true" data-scroll-hint>
      <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
        <path d="M5 1v7M1.5 4.8 5 8.3l3.5-3.5" stroke="currentColor"></path>
      </svg>
    </div>
  </section>

  <section id="projetos" class="projetos">
    <div class="section-header" data-reveal>
      <h2>Projetos</h2>
      <a href="/projetos" class="label ver-todos">VER TODOS</a>
    </div>

    <div class="grid" data-reveal>
      {
        recentes.map((projeto) => (
          <a href={`/projetos/${projeto.slug}`} class="card">
            <img src={projeto.capa} alt={projeto.titulo} loading="lazy" />
            <div class="card-overlay">
              <h3>{projeto.titulo}</h3>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="areas">
    <div class="areas-grid">
      <div class="areas-header" data-reveal>
        <h2>{home?.areasTitulo}</h2>
        {home?.areasNota && <p class="areas-nota">{home?.areasNota}</p>}
      </div>
      <ul class="areas-lista">
        {
          (home?.areas ?? []).map((area, i) => (
            <li class="area-item" data-reveal style={`--stack-index: ${i}`}>
              <span class="label area-num">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="area-corpo">
                <h3>{area.titulo}</h3>
                <p>{area.descricao}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="sobre" class="sobre">
    <div class="sobre-grid">
      <div class="sobre-image" data-reveal>
        {home?.sobreFoto && (
          <img src={siteImage(home.sobreFoto)} alt={home?.sobreTitulo} />
        )}
      </div>
      <div class="sobre-texto" data-reveal>
        <h2>{home?.sobreTitulo}</h2>
        <div class="paragrafos">
          {
            (home?.sobreParagrafos ?? []).map((paragrafo) => (
              <p>{paragrafo}</p>
            ))
          }
        </div>
        <a href={home?.sobreLinkHref ?? '/sobre'} class="label processo-link">
          {home?.sobreLinkLabel}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M2 8h11M9 3.5 13.5 8 9 12.5" stroke="currentColor"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="faixa" data-reveal>
    <p class="faixa-frase">
      {fraseInicio} {fraseFim && <em>{fraseFim}</em>}
    </p>
  </section>

  <section id="processo" class="processo" data-reveal>
    <div class="processo-inner">
      <h2 class="label processo-titulo">{home?.processoTitulo}</h2>
      <div class="processo-grid">
        {
          (home?.processo ?? []).map((passo, i) => (
            <div class="processo-passo">
              <span class="processo-num">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>{passo.titulo}</h3>
              <p>{passo.descricao}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {depoimentos.length > 0 && (
    <section class="depoimentos" aria-labelledby="depoimentos-titulo" data-depoimentos>
      <div class="depoimentos-inner">
        <div class="depoimentos-header" data-reveal>
          <div>
            <h2 id="depoimentos-titulo" class="label depoimentos-titulo">
              {home?.depoimentosTitulo}
            </h2>
            <p class="depoimentos-chamada">
              Nas palavras de quem <em>habita</em>.
            </p>
          </div>
          <div class="depoimentos-controles" data-controles hidden>
            <button type="button" class="depoimentos-seta" data-anterior aria-label="Depoimentos anteriores">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M14 8H3M7 3.5 2.5 8 7 12.5" stroke="currentColor"></path>
              </svg>
            </button>
            <button type="button" class="depoimentos-seta" data-proximo aria-label="Próximos depoimentos">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M2 8h11M9 3.5 13.5 8 9 12.5" stroke="currentColor"></path>
              </svg>
            </button>
          </div>
        </div>

        <ul class="depoimentos-trilho" data-trilho tabindex="0" aria-label="Lista de depoimentos, role para o lado" data-reveal>
          {
            depoimentos.map((dep, i) => (
              <li class="depoimento">
                <figure>
                  <span class="depoimento-aspas" aria-hidden="true">&ldquo;</span>
                  <blockquote class="depoimento-texto" data-texto>
                    {dep.paragrafos.map((p) => <p>{p}</p>)}
                  </blockquote>
                  <button type="button" class="label depoimento-mais" data-mais hidden aria-haspopup="dialog">
                    Ler depoimento completo
                  </button>
                  <figcaption class="depoimento-autor">
                    <span class="depoimento-nome">{dep.nome}</span>
                    {dep.relacao && <span class="label depoimento-relacao">{dep.relacao}</span>}
                  </figcaption>
                </figure>
              </li>
            ))
          }
        </ul>

        <div class="depoimentos-rodape" data-progresso-wrap hidden>
          <div class="depoimentos-progresso" aria-hidden="true">
            <span data-progresso></span>
          </div>
          <div class="depoimentos-controles-mobile">
            <button type="button" class="depoimentos-seta" data-anterior aria-label="Depoimento anterior">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M14 8H3M7 3.5 2.5 8 7 12.5" stroke="currentColor"></path>
              </svg>
            </button>
            <p class="label depoimentos-contador" aria-live="polite" data-contador>
              01 / {String(depoimentos.length).padStart(2, '0')}
            </p>
            <button type="button" class="depoimentos-seta" data-proximo aria-label="Próximo depoimento">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M2 8h11M9 3.5 13.5 8 9 12.5" stroke="currentColor"></path>
              </svg>
            </button>
          </div>
        </div>
      </div>

      <dialog class="depoimento-dialog" data-dialog aria-labelledby="depoimento-dialog-nome">
        <div class="depoimento-dialog-corpo">
          <button type="button" class="depoimento-dialog-fechar" data-fechar aria-label="Fechar depoimento">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 3l10 10M13 3 3 13" stroke="currentColor"></path>
            </svg>
          </button>
          <span class="depoimento-aspas" aria-hidden="true">&ldquo;</span>
          <blockquote class="depoimento-dialog-texto" data-dialog-texto></blockquote>
          <p class="depoimento-autor">
            <span class="depoimento-nome" id="depoimento-dialog-nome" data-dialog-nome></span>
            <span class="label depoimento-relacao" data-dialog-relacao></span>
          </p>
        </div>
      </dialog>
    </section>
  )}

  <section class="cta" data-reveal>
    <h2 class="cta-titulo">{home?.ctaTitulo}</h2>
    <a href={home?.ctaLinkHref ?? '/contato'} class="label cta-link">
      {home?.ctaLinkLabel}
    </a>
  </section>
</PageLayout>

<script>
  // Depoimentos: trilho com setas/progresso, truncamento dos textos longos
  // e dialog com o texto completo. Sem autoplay: textos longos precisam do
  // tempo de leitura de cada pessoa.
  const LINHAS_VISIVEIS = 8;
  let observer: ResizeObserver | null = null;

  function initDepoimentos() {
    const secao = document.querySelector<HTMLElement>('[data-depoimentos]');
    if (!secao || secao.dataset.bound) return;
    secao.dataset.bound = '1';

    const trilho = secao.querySelector<HTMLElement>('[data-trilho]')!;
    const controles = secao.querySelector<HTMLElement>('[data-controles]')!;
    // Setas existem em dois lugares: no cabeçalho (desktop) e no rodapé (mobile).
    const anteriores = [...secao.querySelectorAll<HTMLButtonElement>('[data-anterior]')];
    const proximos = [...secao.querySelectorAll<HTMLButtonElement>('[data-proximo]')];
    const progressoWrap = secao.querySelector<HTMLElement>('[data-progresso-wrap]')!;
    const progresso = secao.querySelector<HTMLElement>('[data-progresso]')!;
    const contador = secao.querySelector<HTMLElement>('[data-contador]')!;
    const dialog = secao.querySelector<HTMLDialogElement>('[data-dialog]')!;
    const cards = [...trilho.children] as HTMLElement[];

    function medirTruncamento() {
      cards.forEach((card) => {
        const texto = card.querySelector<HTMLElement>('[data-texto]')!;
        const mais = card.querySelector<HTMLButtonElement>('[data-mais]')!;
        const paragrafo = texto.querySelector('p');
        if (!paragrafo) return;
        texto.classList.remove('is-truncado');
        const limite = parseFloat(getComputedStyle(paragrafo).lineHeight) * LINHAS_VISIVEIS;
        // Folga de ~1,5 linha: não esconde só uma linha solta atrás do botão.
        const excede = texto.scrollHeight > limite * 1.2;
        texto.classList.toggle('is-truncado', excede);
        mais.hidden = !excede;
      });
    }

    function atualizarNavegacao() {
      const max = trilho.scrollWidth - trilho.clientWidth;
      const temOverflow = max > 2;
      controles.hidden = !temOverflow;
      progressoWrap.hidden = !temOverflow;
      const noInicio = trilho.scrollLeft <= 2;
      const noFim = trilho.scrollLeft >= max - 2;
      anteriores.forEach((b) => (b.disabled = noInicio));
      proximos.forEach((b) => (b.disabled = noFim));
      const visivel = (trilho.clientWidth + trilho.scrollLeft) / trilho.scrollWidth;
      progresso.style.setProperty('--progresso', String(Math.min(1, visivel)));

      const { passo: largura } = medidas();
      const atual = noFim ? cards.length : Math.round(trilho.scrollLeft / largura) + 1;
      const texto = `${String(atual).padStart(2, '0')} / ${String(cards.length).padStart(2, '0')}`;
      if (contador.textContent !== texto) contador.textContent = texto;
    }

    function medidas() {
      const card = cards[0];
      const gap = parseFloat(getComputedStyle(trilho).columnGap) || 0;
      const passo = card.offsetWidth + gap;
      // Tolerância evita que 2,999 (arredondamento de subpixel) vire 2 cards.
      const porPagina = Math.max(1, Math.floor((trilho.clientWidth + gap) / passo + 0.05));
      return { passo, porPagina };
    }

    function avancar(direcao: 1 | -1) {
      const { passo, porPagina } = medidas();
      trilho.scrollBy({ left: direcao * porPagina * passo });
    }

    anteriores.forEach((b) => b.addEventListener('click', () => avancar(-1)));
    proximos.forEach((b) => b.addEventListener('click', () => avancar(1)));
    trilho.addEventListener('scroll', atualizarNavegacao, { passive: true });

    let larguraAnterior = 0;
    observer?.disconnect();
    observer = new ResizeObserver(() => {
      if (trilho.clientWidth === larguraAnterior) return;
      larguraAnterior = trilho.clientWidth;
      // Adia para o próximo frame: medir altera a altura do trilho, e fazer
      // isso dentro do callback gera "ResizeObserver loop" no console.
      requestAnimationFrame(() => {
        medirTruncamento();
        atualizarNavegacao();
      });
    });
    observer.observe(trilho);

    // Dialog
    const dialogTexto = dialog.querySelector<HTMLElement>('[data-dialog-texto]')!;
    const dialogNome = dialog.querySelector<HTMLElement>('[data-dialog-nome]')!;
    const dialogRelacao = dialog.querySelector<HTMLElement>('[data-dialog-relacao]')!;
    let origem: HTMLElement | null = null;

    cards.forEach((card) => {
      card.querySelector('[data-mais]')!.addEventListener('click', (e) => {
        origem = e.currentTarget as HTMLElement;
        dialogTexto.innerHTML = card.querySelector('[data-texto]')!.innerHTML;
        dialogNome.textContent = card.querySelector('.depoimento-nome')?.textContent ?? '';
        const relacao = card.querySelector('.depoimento-relacao')?.textContent ?? '';
        dialogRelacao.textContent = relacao;
        dialogRelacao.hidden = !relacao;
        document.documentElement.style.overflow = 'hidden';
        dialog.showModal();
        dialog.querySelector<HTMLElement>('.depoimento-dialog-corpo')!.scrollTop = 0;
      });
    });

    dialog.querySelector('[data-fechar]')!.addEventListener('click', () => dialog.close());
    // Clique no backdrop (fora do corpo) fecha.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      origem?.focus();
    });
  }

  document.addEventListener('astro:page-load', initDepoimentos);
  document.addEventListener('astro:before-swap', () => {
    observer?.disconnect();
    observer = null;
    document.documentElement.style.overflow = '';
  });
</script>

<style>
  /* Hero */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 100svh;
    overflow: hidden;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(12, 12, 12, 0.36);
  }

  .hero-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding-inline: 1.5rem;
    text-align: center;
  }

  .hero-content h1 {
    font-family: var(--font-h1);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.47;
    letter-spacing: -0.027em;
    color: #fff;
    white-space: pre-line;
  }

  .hero-nota {
    margin-top: -1rem;
    color: rgba(255, 255, 255, 0.95);
  }

  .hero-link {
    padding: 1rem 2rem;
    border: 1px solid rgba(255, 255, 255, 0.5);
    color: #fff;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      transform 160ms var(--ease-out);
  }

  .hero-link:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: #fff;
  }

  .hero-link:active {
    transform: scale(0.97);
  }

  .scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.7);
    opacity: 1;
    transition: opacity 400ms ease-out, transform 400ms ease-out;
  }

  .scroll-hint--hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(-8px);
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint {
      transition: none;
    }
  }

  /* Projetos */
  .projetos {
    max-width: 80rem;
    margin-inline: auto;
    padding: 8rem 5rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--accent);
  }

  .section-header h2,
  .sobre-texto h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2rem;
    line-height: 1.3;
    color: var(--ink);
  }

  .ver-todos {
    color: var(--muted);
    transition: color 150ms ease;
  }

  .ver-todos:hover {
    color: var(--ink);
  }


  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 4rem;
  }

  .card {
    position: relative;
    aspect-ratio: 352 / 500;
    overflow: hidden;
    background: var(--surface);
  }

  .card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover img {
      transform: scale(1.04);
    }
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgba(12, 12, 12, 0.2);
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .card:hover .card-overlay,
  .card:focus-visible .card-overlay {
    opacity: 1;
  }

  .card-overlay h3 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.4;
    letter-spacing: 0.025em;
    color: #fff;
    text-align: center;
  }

  /* Sobre */
  .sobre {
    background: var(--surface);
    padding: 12rem 5rem 8rem;
  }

  .sobre-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 2rem;
    max-width: 80rem;
    margin-inline: auto;
  }

  .sobre-image {
    grid-column: 1 / span 5;
    position: relative;
    align-self: center;
  }

  .sobre-image::after {
    content: '';
    position: absolute;
    inset: 1rem;
    border: 1px solid var(--accent);
    pointer-events: none;
  }

  .sobre-image img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  .sobre-texto {
    grid-column: 7 / span 6;
    align-self: center;
  }

  .sobre-texto h2 {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--accent);
    margin-bottom: 2rem;
  }

  .paragrafos {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .paragrafos p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--body-color);
  }

  .processo-link {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    padding-bottom: 4px;
    color: var(--ink);
  }

  .processo-link svg {
    transition: transform 200ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .processo-link:hover svg {
      transform: translateX(4px);
    }
  }

  /* CTA */
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.3rem;
    padding: 8rem 5rem;
    text-align: center;
  }

  .cta-titulo {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
    white-space: pre-line;
  }

  .cta-link {
    padding-bottom: 8px;
    border-bottom: 1px solid var(--ink);
    color: var(--ink);
    transition: opacity 150ms ease;
  }

  .cta-link:hover {
    opacity: 0.7;
  }

  /* Áreas de Atuação */
  .areas {
    max-width: 80rem;
    margin-inline: auto;
    padding: 8rem 5rem;
  }

  .areas-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 2rem;
  }

  .areas-header {
    grid-column: 1 / span 4;
    grid-row: 1;
    position: sticky;
    top: 6.5rem;
    align-self: start;
  }

  @media (prefers-reduced-motion: reduce) {
    .areas-header {
      position: static;
    }
  }

  .areas-header h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2rem;
    line-height: 1.3;
    color: var(--ink);
  }

  .areas-nota {
    margin-top: 1rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .areas-lista {
    grid-column: 5 / span 8;
    grid-row: 1;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .area-item {
    position: sticky;
    top: calc(6.5rem + var(--stack-index) * 3rem);
