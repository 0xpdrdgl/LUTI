---
import PageLayout from '../layouts/PageLayout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { projetosImage, siteImage } from '../lib/images';

const reader = createReader(process.cwd(), keystaticConfig);
const home = await reader.singletons.home.read();
const projetos = await reader.collections.projetos.all();

const recentes = projetos
  .map(({ slug, entry }) => ({
    slug,
    titulo: entry.titulo,
    capa: projetosImage(entry.capa),
  }))
  .slice(0, 3);
---

<PageLayout title="LUIZA TINOCO — Arquitetura" fullBleed>
  <section class="hero">
    <img
      src={home?.heroImagem ? siteImage(home.heroImagem) ?? '/images/hero.webp' : '/images/hero.webp'}
      alt=""
      class="hero-image"
    />
    <div class="hero-overlay"></div>
    <div class="hero-content" data-reveal>
      <h1>{home?.heroTitulo}</h1>
      <a href={home?.heroBotaoHref ?? '/projetos'} class="label hero-link">
        {home?.heroBotaoLabel}
      </a>
    </div>
    <div class="scroll-hint" aria-hidden="true" data-scroll-hint>
      <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
        <path d="M5 1v7M1.5 4.8 5 8.3l3.5-3.5" stroke="currentColor"></path>
      </svg>
    </div>
  </section>

  <section id="projetos" class="projetos">
    <div class="section-header" data-reveal>
      <h2>Projetos Recentes</h2>
      <a href="/projetos" class="label ver-todos">VER TODOS</a>
    </div>

    <div class="grid" data-reveal>
      {
        recentes.map((projeto) => (
          <a href={`/projetos/${projeto.slug}`} class="card">
            <img src={projeto.capa} alt={projeto.titulo} loading="lazy" />
            <div class="card-overlay">
              <h3>{projeto.titulo}</h3>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="areas" data-reveal>
    <div class="areas-grid">
      <div class="areas-header">
        <h2>{home?.areasTitulo}</h2>
      </div>
      <ul class="areas-lista">
        {
          (home?.areas ?? []).map((area, i) => (
            <li class="area-item">
              <span class="label area-num">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="area-corpo">
                <h3>{area.titulo}</h3>
                <p>{area.descricao}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="sobre" class="sobre">
    <div class="sobre-grid">
      <div class="sobre-image" data-reveal>
        {home?.sobreFoto && (
          <img src={siteImage(home.sobreFoto)} alt={home?.sobreTitulo} />
        )}
      </div>
      <div class="sobre-texto" data-reveal>
        <h2>{home?.sobreTitulo}</h2>
        <div class="paragrafos">
          {
            (home?.sobreParagrafos ?? []).map((paragrafo) => (
              <p>{paragrafo}</p>
            ))
          }
        </div>
        <a href={home?.sobreLinkHref ?? '/sobre'} class="label processo-link">
          {home?.sobreLinkLabel}
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M2 8h11M9 3.5 13.5 8 9 12.5" stroke="currentColor"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="faixa" data-reveal>
    <p class="faixa-frase">{home?.faixaFrase}</p>
  </section>

  <section id="processo" class="processo" data-reveal>
    <div class="processo-inner">
      <h2 class="label processo-titulo">{home?.processoTitulo}</h2>
      <div class="processo-grid">
        {
          (home?.processo ?? []).map((passo, i) => (
            <div class="processo-passo">
              <span class="processo-num">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>{passo.titulo}</h3>
              <p>{passo.descricao}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="cta" data-reveal>
    <h2 class="cta-titulo">{home?.ctaTitulo}</h2>
    <a href={home?.ctaLinkHref ?? '/contato'} class="label cta-link">
      {home?.ctaLinkLabel}
    </a>
  </section>
</PageLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 100svh;
    overflow: hidden;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(12, 12, 12, 0.31);
  }

  .hero-content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    padding-inline: 1.5rem;
    text-align: center;
  }

  .hero-content h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.47;
    letter-spacing: -0.027em;
    color: #fff;
    white-space: pre-line;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.05));
  }

  .hero-link {
    padding: 1rem 2rem;
    border: 1px solid rgba(255, 255, 255, 0.5);
    color: #fff;
    transition:
      background-color 200ms ease,
      border-color 200ms ease,
      transform 160ms var(--ease-out);
  }

  .hero-link:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: #fff;
  }

  .hero-link:active {
    transform: scale(0.97);
  }

  .scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255, 255, 255, 0.7);
    opacity: 1;
    transition: opacity 400ms ease-out, transform 400ms ease-out;
  }

  .scroll-hint--hidden {
    opacity: 0;
    pointer-events: none;
    transform: translateX(-50%) translateY(-8px);
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-hint {
      transition: none;
    }
  }

  /* Projetos Recentes */
  .projetos {
    max-width: 80rem;
    margin-inline: auto;
    padding: 8rem 5rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--accent);
  }

  .section-header h2,
  .sobre-texto h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2rem;
    line-height: 1.3;
    color: var(--ink);
  }

  .ver-todos {
    color: var(--muted);
    transition: color 150ms ease;
  }

  .ver-todos:hover {
    color: var(--ink);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 4rem;
  }

  .card {
    position: relative;
    aspect-ratio: 352 / 500;
    overflow: hidden;
    background: var(--surface);
  }

  .card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .card:hover img {
      transform: scale(1.04);
    }
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    background: rgba(12, 12, 12, 0.2);
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .card:hover .card-overlay,
  .card:focus-visible .card-overlay {
    opacity: 1;
  }

  .card-overlay h3 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.4;
    letter-spacing: 0.025em;
    color: #fff;
    text-align: center;
  }

  /* Sobre */
  .sobre {
    background: var(--surface);
    padding: 12rem 5rem 8rem;
  }

  .sobre-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 2rem;
    max-width: 80rem;
    margin-inline: auto;
  }

  .sobre-image {
    grid-column: 1 / span 5;
    position: relative;
    align-self: center;
  }

  .sobre-image::after {
    content: '';
    position: absolute;
    inset: 1rem;
    border: 1px solid var(--accent);
    pointer-events: none;
  }

  .sobre-image img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  .sobre-texto {
    grid-column: 7 / span 6;
    align-self: center;
  }

  .sobre-texto h2 {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--accent);
    margin-bottom: 2rem;
  }

  .paragrafos {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  .paragrafos p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--body-color);
  }

  .processo-link {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    padding-bottom: 4px;
    color: var(--ink);
  }

  .processo-link svg {
    transition: transform 200ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .processo-link:hover svg {
      transform: translateX(4px);
    }
  }

  /* CTA */
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.3rem;
    padding: 8rem 5rem;
    text-align: center;
  }

  .cta-titulo {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
    white-space: pre-line;
  }

  .cta-link {
    padding-bottom: 8px;
    border-bottom: 1px solid var(--ink);
    color: var(--ink);
    transition: opacity 150ms ease;
  }

  .cta-link:hover {
    opacity: 0.7;
  }

  /* Áreas de Atuação */
  .areas {
    max-width: 80rem;
    margin-inline: auto;
    padding: 8rem 5rem;
  }

  .areas-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 2rem;
  }

  .areas-header {
    grid-column: 1 / span 4;
    grid-row: 1;
  }

  .areas-header h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2rem;
    line-height: 1.3;
    color: var(--ink);
  }

  .areas-lista {
    grid-column: 5 / span 8;
    grid-row: 1;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .area-item {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1.5rem;
    padding-block: 2rem;
    border-top: 1px solid var(--accent);
  }

  .areas-lista li:last-child {
    border-bottom: 1px solid var(--accent);
  }

  .area-num {
    color: var(--muted);
    padding-top: 0.4rem;
  }

  .area-corpo h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.375rem;
    line-height: 1.3;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }

  .area-corpo p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--body-color);
    max-width: 52ch;
  }

  /* Faixa editorial */
  .faixa {
    background: var(--surface);
    padding: 8rem 1.5rem;
  }

  .faixa-frase {
    max-width: 34ch;
    margin-inline: auto;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    line-height: 1.35;
    color: var(--ink);
    text-wrap: balance;
  }

  /* Processo */
  .processo {
    padding: 8rem 5rem;
    scroll-margin-top: 5rem;
  }

  .processo-inner {
    max-width: 80rem;
    margin-inline: auto;
  }

  .processo-titulo {
    color: var(--muted);
  }

  .processo-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    margin-top: 3rem;
  }

  .processo-passo {
    border-top: 1px solid var(--ink);
    padding-top: 1.5rem;
  }

  .processo-num {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2rem;
    line-height: 1;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .processo-passo h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.375rem;
    line-height: 1.3;
    color: var(--ink);
    margin-bottom: 0.5rem;
  }

  .processo-passo p {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--body-color);
  }

  @media (max-width: 64rem) {
    .areas {
      padding-block: 5rem;
    }

    .areas-grid {
      display: flex;
      flex-direction: column;
      gap: 2.5rem;
    }

    .faixa {
      padding-block: 5rem;
    }

    .processo {
      padding: 5rem 1.5rem;
    }

    .processo-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 40rem) {
    .processo-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 64rem) {
    .projetos,
    .sobre,
    .cta {
      padding-inline: 1.5rem;
    }

    .projetos {
      padding-block: 5rem;
    }

    .sobre {
      padding-block: 5rem;
    }

    .cta {
      padding-block: 5rem;
    }

    .grid {
      grid-template-columns: 1fr;
      max-width: 24rem;
      margin-inline: auto;
    }

    .sobre-grid {
      display: flex;
      flex-direction: column;
      gap: 3rem;
    }
  }
</style>
