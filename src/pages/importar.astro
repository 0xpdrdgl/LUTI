---
export const prerender = false;

if (import.meta.env.PROD) {
  return new Response('Not found', { status: 404 });
}
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Importar projetos (dev only)</title>
    <style>
      body {
        font-family: system-ui, sans-serif;
        background: #111;
        color: #eee;
        max-width: 44rem;
        margin: 3rem auto;
        padding: 0 1.5rem;
      }
      h1 { font-size: 1.4rem; }
      p { color: #999; line-height: 1.6; }
      code { background: #222; padding: 2px 6px; border-radius: 4px; }
      #drop {
        border: 2px dashed #555;
        border-radius: 12px;
        padding: 3rem;
        text-align: center;
        margin: 2rem 0;
        transition: border-color 150ms, background 150ms;
      }
      #drop.sobre { border-color: #8ab4ff; background: #1a2333; }
      button {
        background: #eee;
        color: #111;
        border: 0;
        padding: 0.8rem 1.6rem;
        border-radius: 8px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
      }
      button:disabled { opacity: 0.4; cursor: wait; }
      ul { list-style: none; padding: 0; }
      li { padding: 0.4rem 0; border-bottom: 1px solid #222; font-size: 0.9rem; }
      .ok::before { content: '✓ '; color: #6f6; }
      .dup::before { content: '↷ '; color: #fa0; }
      .err::before { content: '✗ '; color: #f66; }
      a { color: #8ab4ff; }
      .modo {
        border: 1px solid #333;
        border-radius: 12px;
        padding: 1.5rem;
        margin: 1.5rem 0;
      }
      .modo h2 { font-size: 1.05rem; margin-top: 0; }
      .linha { display: flex; gap: 0.75rem; margin: 0.75rem 0; flex-wrap: wrap; align-items: center; }
      input[type="password"], input[type="text"] {
        flex: 1;
        min-width: 200px;
        background: #1a1a1a;
        border: 1px solid #444;
        border-radius: 8px;
        padding: 0.6rem 0.8rem;
        color: #eee;
        font-size: 0.95rem;
      }
      .check { display: flex; align-items: center; gap: 0.5rem; color: #bbb; font-size: 0.9rem; }
      #llm-model { max-width: 220px; flex: none; }
      #posts {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: 0.75rem;
        margin: 1rem 0;
        max-height: 26rem;
        overflow-y: auto;
      }
      .post {
        border: 1px solid #333;
        border-radius: 8px;
        overflow: hidden;
        cursor: pointer;
        background: #1a1a1a;
      }
      .post.selecionado { border-color: #8ab4ff; }
      .post img { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; }
      .post .legenda {
        padding: 0.5rem;
        font-size: 0.72rem;
        color: #aaa;
        max-height: 4.5rem;
        overflow: hidden;
        text-align: left;
      }
      .primario { background: #8ab4ff; }
      .secundario { background: none; border: 1px solid #555; color: #eee; padding: 0.6rem 1.2rem; border-radius: 8px; cursor: pointer; }

      /* Modal de seleção de posts */
      #modal-selecao {
        width: 92vw;
        height: 75vh;
        max-width: 880px;
        max-height: 75vh;
        border: 1px solid #333;
        border-radius: 12px;
        padding: 0;
        background: #111;
        color: #eee;
      }
      #modal-selecao::backdrop { background: rgba(0,0,0,0.6); }
      .modal-corpo {
        display: flex;
        flex-direction: column;
        height: 100%;
      }
      .modal-topo {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.6rem 1rem;
        border-bottom: 1px solid #2a2a2a;
      }
      .modal-topo h2 { font-size: 0.9rem; margin: 0; font-weight: 500; }
      #modal-fechar {
        background: none; border: none; color: #888;
        font-size: 1.4rem; cursor: pointer; line-height: 1;
        padding: 0.2rem 0.5rem;
      }
      #modal-fechar:hover { color: #fff; }
      #modal-posts {
        flex: 1;
        overflow-y: auto;
        padding: 0;
      }
      .posts-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.78rem;
      }
      .posts-table thead th {
        position: sticky;
        top: 0;
        background: #111;
        z-index: 1;
      }
      .posts-table th,
      .posts-table td {
        padding: 0.35rem 0.6rem;
        border-bottom: 1px solid #1f1f1f;
        text-align: left;
        vertical-align: middle;
      }
      .posts-table th {
        color: #777;
        font-weight: 500;
        font-size: 0.62rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }
      .posts-table tr:hover td {
        background: #181818;
      }
      .posts-table .col-check { width: 36px; }
      .posts-table .col-thumb { width: 40px; }
      .posts-table .col-legenda { min-width: 0; }
      .posts-table .col-meta { width: 120px; color: #666; font-size: 0.68rem; white-space: nowrap; }
      .posts-table .thumb {
        width: 28px;
        height: 28px;
        object-fit: cover;
        border-radius: 3px;
        display: block;
        flex-shrink: 0;
      }
      .posts-table .legenda {
        max-width: 100%;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: #ddd;
        font-size: 0.78rem;
        line-height: 1.3;
      }
      .posts-table .badge-carrossel {
        display: inline-block;
        background: #2a2a2a;
        color: #999;
        font-size: 0.58rem;
        padding: 1px 5px;
        border-radius: 10px;
        margin-left: 0.4rem;
      }
      .posts-table input[type="checkbox"] {
        width: 15px;
        height: 15px;
        accent-color: #8ab4ff;
        cursor: pointer;
      }
      .posts-table tr.selecionado td {
        background: #15202d;
      }
      .posts-table tr.selecionado .legenda { color: #fff; }
      .modal-rodape {
        padding: 0.6rem 1rem;
        border-top: 1px solid #2a2a2a;
        text-align: right;
      }
    </style>
  </head>
  <body>
    <h1>Importar projetos (dev only)</h1>

    <section class="modo">
      <h2>① Do Instagram via Apify</h2>
      <p>
        Rode o actor
        <code>apify/instagram-post-scraper</code> com o perfil desejado no
        Apify, depois cole seu token aqui pra puxar o resultado.
      </p>
      <div class="linha">
        <input type="password" id="apify-token" placeholder="Token da API do Apify" value="apify_api_XYZ" />
        <button type="button" id="btn-buscar">Buscar posts</button>
      </div>
      <div class="linha">
        <input type="text" id="apify-run-id" placeholder="Run ID (opcional — vazio = última execução)" />
      </div>
      <div class="linha">
        <label class="check">
          <input type="checkbox" id="usar-gemini" checked />
          Gerar título/descrição/categoria com Gemini
        </label>
        <select id="gemini-model">
          <option value="gemini-2.5-flash" selected>gemini-2.5-flash (rápido)</option>
          <option value="gemini-2.5-pro">gemini-2.5-pro (melhor)</option>
          <option value="gemini-2.0-flash">gemini-2.0-flash</option>
          <option value="gemini-2.0-flash-lite">gemini-2.0-flash-lite</option>
        </select>
        <input
          type="password"
          id="gemini-key"
          placeholder="Chave da API Gemini (aistudio.google.com)"
        />
      </div>
      <div class="linha">
        <span class="check">ou suba o export do Apify (JSON/CSV):</span>
        <input type="file" id="arquivo-export" accept=".json,.csv" />
      </div>
      <div id="posts"></div>
      <button type="button" id="btn-instagram" disabled class="primario" style="display:none">
        Importar selecionados
      </button>

      <!-- Modal de seleção -->
      <dialog id="modal-selecao">
        <div class="modal-corpo">
          <div class="modal-topo">
            <h2>Selecione os posts</h2>
            <button type="button" id="modal-fechar" aria-label="Fechar">×</button>
          </div>
          <div id="modal-posts"></div>
          <div class="modal-rodape">
            <button type="button" id="btn-modal-importar" class="primario">
              Importar selecionados
            </button>
          </div>
        </div>
      </dialog>
    </section>

    <section class="modo">
      <h2>② Do computador (arquivos)</h2>
      <p>
        💡 Pra baixar as imagens do perfil de uma vez, use uma extensão
        como <strong>Fatkun Batch Image Downloader</strong> na aba do Instagram.
      </p>
    </section>

    <div id="drop">
      Arraste as imagens aqui (ou uma pasta inteira) ou
      <input type="file" id="files" multiple accept="image/*" />
      <p id="status"></p>
    </div>
    <button id="btn" disabled>Importar tudo</button>
    <ul id="log"></ul>

    <script>
      const drop = document.getElementById('drop');
      const input = document.getElementById('files');
      const btn = document.getElementById('btn');
      const log = document.getElementById('log');
      const status = document.getElementById('status');
      let arquivos = [];

      function setArquivos(lista) {
        arquivos = [...lista].filter((f) => f.type.startsWith('image/'));
        status.textContent = arquivos.length
          ? `${arquivos.length} imagem(ns) prontas pra importar`
          : 'Nenhuma imagem detectada — solte arquivos de imagem ou a pasta com elas';
        btn.disabled = arquivos.length === 0;
        btn.textContent = arquivos.length
          ? `Importar ${arquivos.length} imagem(ns)`
          : 'Importar tudo';
      }

      // Suporta pastas: percorre as entradas recursivamente
      async function coletarDeDrop(dataTransfer) {
        const encontrados = [];
        const entradas = [];
        for (const item of dataTransfer.items) {
          const entry = item.webkitGetAsEntry?.();
          if (entry) entradas.push(entry);
        }
        if (entradas.length === 0) return [...dataTransfer.files];

        async function ler(entry) {
          if (entry.isFile) {
            const file = await new Promise((res, rej) => entry.file(res, rej));
            encontrados.push(file);
          } else if (entry.isDirectory) {
            const reader = entry.createReader();
            let lote;
            do {
              lote = await new Promise((res, rej) =>
                reader.readEntries(res, rej),
              );
              for (const e of lote) await ler(e);
            } while (lote.length > 0);
          }
        }

        for (const entry of entradas) await ler(entry);
        return encontrados;
      }

      input.addEventListener('change', () => setArquivos(input.files));

      drop.addEventListener('dragover', (e) => {
        e.preventDefault();
        drop.classList.add('sobre');
      });
      drop.addEventListener('dragleave', () => drop.classList.remove('sobre'));
      drop.addEventListener('drop', async (e) => {
        e.preventDefault();
        drop.classList.remove('sobre');
        status.textContent = 'Lendo arquivos...';
        const encontrados = await coletarDeDrop(e.dataTransfer);
        setArquivos(encontrados);
      });
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        for (const [i, file] of arquivos.entries()) {
          const li = document.createElement('li');
          li.textContent = `${i + 1}/${arquivos.length} — ${file.name}...`;
          log.appendChild(li);
          try {
            const fd = new FormData();
            fd.append('file', file);
            fd.append('nome', file.name);
            const res = await fetch('/api/importar', { method: 'POST', body: fd });
            const data = await res.json();
            if (data.duplicado) {
              li.className = 'dup';
              li.textContent += ` duplicado, ignorado (${data.slug})`;
            } else {
              li.className = 'ok';
              li.textContent += ` criado "${data.titulo}" → /projetos/${data.slug}`;
            }
          } catch (e) {
            li.className = 'err';
            li.textContent += ` ERRO: ${e.message}`;
          }
        }
        btn.disabled = false;
        btn.textContent = 'Importar mais';
        const fim = document.createElement('li');
        fim.innerHTML = `<strong>Pronto!</strong> Revise em <a href="/admin" target="_blank">/admin</a>`;
        log.appendChild(fim);
      });

      /* ---------- Instagram via Apify ---------- */
      const tokenInput = document.getElementById('apify-token');
      const runIdInput = document.getElementById('apify-run-id');
      const btnBuscar = document.getElementById('btn-buscar');
      const postsDiv = document.getElementById('posts');
      const btnInstagram = document.getElementById('btn-modal-importar');
      const modalFechar = document.getElementById('modal-fechar');
      const modalEl = document.getElementById('modal-selecao');
      const usarLLMInput = document.getElementById('usar-gemini');
      const modelInput = document.getElementById('gemini-model');
      const keyInput = document.getElementById('gemini-key');
      const arquivoExport = document.getElementById('arquivo-export');
      let postsEncontrados = [];

      // CSV minimalista com suporte a campos entre aspas
      function parseCSV(texto) {
        const linhas = [];
        let linha = [];
        let campo = '';
        let aspas = false;
        for (let i = 0; i < texto.length; i++) {
          const ch = texto[i];
          if (aspas) {
            if (ch === '"') {
              if (texto[i + 1] === '"') {
                campo += '"';
                i++;
              } else aspas = false;
            } else campo += ch;
          } else if (ch === '"') aspas = true;
          else if (ch === ',') {
            linha.push(campo);
            campo = '';
          } else if (ch === '\n' || ch === '\r') {
            if (ch === '\r' && texto[i + 1] === '\n') i++;
            linha.push(campo);
            campo = '';
            if (linha.some((c) => c !== '')) linhas.push(linha);
            linha = [];
          } else campo += ch;
        }
        if (campo !== '' || linha.length) {
          linha.push(campo);
          if (linha.some((c) => c !== '')) linhas.push(linha);
        }
        return linhas;
      }

      function itensDoArquivo(texto, nome) {
        if (nome.endsWith('.json')) {
          const dados = JSON.parse(texto);
          return Array.isArray(dados) ? dados : (dados.data ?? []);
        }
        // CSV
        const linhas = parseCSV(texto);
        if (linhas.length < 2) return [];
        const header = linhas[0];
        const col = (nomes) =>
          header.findIndex((h) => nomes.some((n) => h.toLowerCase() === n));
        const cDisplay = col(['displayurl', 'display_url', 'image', 'imagem']);
        const cCaption = col(['caption', 'legenda']);
        const cTimestamp = col(['timestamp', 'date', 'data']);
        const cChild = col(['childposts', 'child_posts']);
        const cImages = col(['imageurls', 'image_urls', 'images']);
        return linhas.slice(1).map((linha, i) => {
          const item = { id: String(i) };
          if (cDisplay >= 0) item.displayUrl = linha[cDisplay];
          if (cCaption >= 0) item.caption = linha[cCaption];
          if (cTimestamp >= 0) item.timestamp = linha[cTimestamp];
          if (cChild >= 0) {
            try { item.childPosts = JSON.parse(linha[cChild]); } catch {}
          }
          if (cImages >= 0) {
            try { item.imageUrls = JSON.parse(linha[cImages]); } catch {}
          }
          return item;
        });
      }

      async function carregarItems(items) {
        const res = await fetch('/api/instagram-preview', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ items }),
        });
        return res.json();
      }

      function proxyUrl(url, width) {
        const base = `/api/ig-image?url=${encodeURIComponent(url)}`;
        return width ? `${base}&w=${width}` : base;
      }

function renderPosts(posts) {
        postsEncontrados = posts;
        status.textContent = `${posts.length} post(s) encontrado(s) - desmarque os que não quiser`;
        postsDiv.innerHTML = '';
        const modalPosts = document.getElementById('modal-posts');
        modalPosts.innerHTML = `
          <table class="posts-table">
            <thead>
              <tr>
                <th class="col-check"><input type="checkbox" id="select-all" /></th>
                <th class="col-thumb">Imagem</th>
                <th class="col-legenda">Legenda</th>
                <th class="col-meta">Data / Carrossel</th>
              </tr>
            </thead>
            <tbody></tbody>
          </table>
        `;
        const tbody = modalPosts.querySelector('tbody');
        const selectAll = modalPosts.querySelector('#select-all');

        posts.forEach((post, i) => {
          const tr = document.createElement('tr');
          tr.className = 'selecionado';
          const badge =
            post.imagensExtras?.length > 0
              ? `<span class="badge-carrossel">🖼 ${post.imagensExtras.length + 1} imgs</span>`
              : '';
          const dateStr = post.timestamp
            ? new Date(post.timestamp).toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit' })
            : '—';
          tr.innerHTML = `
            <td class="col-check"><input type="checkbox" checked data-index="${i}" /></td>
            <td class="col-thumb"><img class="thumb" src="${proxyUrl(post.imagem, 100)}" loading="lazy" decoding="async" alt="" /></td>
            <td class="col-legenda">
              <div class="legenda">${(post.legenda || '(sem legenda)').slice(0, 100)}</div>
            </td>
            <td class="col-meta">${dateStr}${badge}</td>
          `;
          const checkbox = tr.querySelector('input');
          checkbox.addEventListener('change', () => {
            tr.classList.toggle('selecionado', checkbox.checked);
            updateSelectAll();
          });
          tbody.appendChild(tr);
        });

        function updateSelectAll() {
          const checkboxes = tbody.querySelectorAll('input[data-index]');
          const checked = [...checkboxes].filter((c) => c.checked).length;
          selectAll.checked = checked === checkboxes.length;
          selectAll.indeterminate = checked > 0 && checked < checkboxes.length;
        }

        selectAll.addEventListener('change', () => {
          tbody.querySelectorAll('input[data-index]').forEach((cb) => {
            cb.checked = selectAll.checked;
            cb.dispatchEvent(new Event('change'));
          });
        });

        modalEl.showModal();
      }

      modalFechar.addEventListener('click', () => modalEl.close());
      modalEl.addEventListener('click', (e) => {
        if (e.target === modalEl) modalEl.close();
      });

      btnBuscar.addEventListener('click', async () => {
        const token = tokenInput.value.trim();
        if (!token) {
          status.textContent = 'Cole o token do Apify primeiro';
          return;
        }
        const runId = runIdInput.value.trim();
        btnBuscar.disabled = true;
        btnBuscar.textContent = 'Buscando...';
        postsDiv.innerHTML = '';
        try {
          const res = await fetch('/api/instagram-preview', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ token, runId: runId || null }),
          });
          const dados = await res.json();
          if (dados.erro) {
            status.textContent = `Erro: ${dados.erro}`;
            return;
          }
          renderPosts(dados.posts);
        } catch (e) {
          status.textContent = `Erro: ${e.message}`;
        } finally {
          btnBuscar.disabled = false;
          btnBuscar.textContent = 'Buscar posts';
        }
      });

      arquivoExport.addEventListener('change', async () => {
        const file = arquivoExport.files[0];
        if (!file) return;
        status.textContent = 'Lendo arquivo...';
        try {
          const texto = await file.text();
          const items = itensDoArquivo(texto, file.name.toLowerCase());
          if (!items.length) {
            status.textContent = 'Nenhum item encontrado no arquivo';
            return;
          }
          const data = await carregarItems(items);
          if (data.erro) {
            status.textContent = `Erro: ${data.erro}`;
            return;
          }
          renderPosts(data.posts);
        } catch (e) {
          status.textContent = `Erro ao ler arquivo: ${e.message}`;
        }
      });

      btnInstagram.addEventListener('click', async () => {
        const token = tokenInput.value.trim();
        const modalPosts = document.getElementById('modal-posts');
        const selecionados = [...modalPosts.querySelectorAll('tr.selecionado')].map(
          (tr) => postsEncontrados[+tr.querySelector('input[data-index]').dataset.index],
        );
        if (!selecionados.length) return;

        const esperar = (ms) => new Promise((r) => setTimeout(r, ms));
        const comGemini = usarLLMInput.checked && keyInput.value.trim();

        btnInstagram.disabled = true;
        for (const [i, post] of selecionados.entries()) {
          const li = document.createElement('li');
          li.textContent = `${i + 1}/${selecionados.length} — importando...`;
          log.appendChild(li);

          console.log('📤 Enviando post:', {
            shortCode: post.shortCode,
            hasImagem: !!post.imagem,
            imagensExtrasCount: post.imagensExtras?.length || 0,
            imagensExtras: post.imagensExtras
          });

          let data = null;
          let semIA = false;

          for (let tentativa = 0; tentativa < 3; tentativa++) {
            try {
              const res = await fetch('/api/importar-instagram', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({
                  token,
                  post,
                  usarGemini: usarLLMInput.checked,
                  geminiModel: modelInput.value,
                  geminiKey: keyInput.value.trim(),
                }),
              });

              if (res.status === 429) {
                li.textContent = `${i + 1}/${selecionados.length} — limite do Gemini, aguardando 20s (tentativa ${tentativa + 1})...`;
                await esperar(20000);
                continue;
              }

              data = await res.json().catch(() => ({}));
              break;
            } catch (e) {
              data = { erro: e.message };
              break;
            }
          }

          // limite persistente após 3 tentativas: importa sem IA
          if (data?.rateLimited) {
            semIA = true;
            li.textContent = `${i + 1}/${selecionados.length} — importando sem IA...`;
            try {
              const res = await fetch('/api/importar-instagram', {
                method: 'POST',
                headers: { 'content-type': 'application/json' },
                body: JSON.stringify({ token, post, usarGemini: false }),
              });
              data = await res.json().catch(() => ({}));
            } catch (e) {
              data = { erro: e.message };
            }
          }

          if (data?.erro) {
            li.className = 'err';
            li.textContent += ` ERRO: ${data.erro}`;
          } else if (data?.duplicado) {
            li.className = 'dup';
            li.textContent += ` duplicado, ignorado (${data.slug})`;
          } else if (data?.slug) {
            li.className = 'ok';
            li.textContent += ` criado "${data.titulo}" (${data.categoria}${data.usouLLM ? ', via Gemini' : ', sem IA'}) → /projetos/${data.slug}`;
          } else {
            li.className = 'err';
            li.textContent += ' ERRO desconhecido';
          }

          if (comGemini && i < selecionados.length - 1) await esperar(2500);
        }
        btnInstagram.disabled = false;
        btnInstagram.textContent = 'Importar mais';
        const fim = document.createElement('li');
        fim.innerHTML = `<strong>Pronto!</strong> Revise em <a href="/admin" target="_blank">/admin</a>`;
