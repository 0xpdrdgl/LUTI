---
import PageLayout from '../layouts/PageLayout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { siteImage } from '../lib/images';

const pagina = await createReader(process.cwd(), keystaticConfig).singletons.paginaSobre.read();
---

<PageLayout
  title="Sobre — LUIZA TINOCO"
  description="Arquitetura que respira. Uma abordagem autoral que abraça a textura, a luz natural e a verdadeira essência de quem habita."
>
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-texto" data-reveal>
        <h1>
          <span class="linha-1">{pagina?.tituloPrincipal}</span><br />
          <em>{pagina?.tituloItalico}</em>
        </h1>
        <div class="divisor" aria-hidden="true"></div>
        <p class="hero-lead">{pagina?.lead}</p>
        <p class="hero-nota">{pagina?.nota}</p>
      </div>
      <figure class="hero-retrato" data-reveal>
        {pagina?.retrato && (
          <img src={siteImage(pagina.retrato)} alt={pagina?.tituloItalico} />
        )}
      </figure>
    </div>
  </section>

  <section class="visao">
    <div class="visao-cta" data-reveal>
      <a href="/contato" class="label sobre-cta">
        ENTRAR EM CONTATO
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
          <path d="M1 6h9M6.5 2 10.5 6 6.5 10" stroke="currentColor"></path>
        </svg>
      </a>
    </div>
  </section>
</PageLayout>

<style>
  /* Hero editorial */
  .hero {
    max-width: 70rem;
    margin-inline: auto;
    padding: 4rem 1.5rem 8rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 2rem;
  }

  .hero-texto {
    grid-column: 1 / span 6;
    align-self: center;
  }

  .hero-texto h1 {
    font-family: var(--font-h1);
    font-weight: 400;
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.09;
    color: var(--ink);
  }

  .linha-1 {
    white-space: nowrap;
  }

  .hero-texto em {
    font-style: italic;
  }

  .divisor {
    width: 3rem;
    height: 1px;
    background: var(--accent);
    margin-block: 2.5rem;
  }

  .hero-lead {
    max-width: 28rem;
    font-size: 1.125rem;
    line-height: 1.6;
    letter-spacing: 0.01em;
    color: var(--body-color);
  }

  .hero-nota {
    margin-top: 2.5rem;
    max-width: 28rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--body-color);
  }

  .hero-retrato {
    grid-column: 8 / span 5;
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--surface);
  }

  .hero-retrato::before {
    content: '';
    position: absolute;
    inset: 0;
    transform: translate(1rem, 1rem);
    background: var(--surface);
    z-index: 0;
  }

  .hero-retrato img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* CTA de contato (antiga seção Nossa Visão) */
  .visao {
    background: var(--surface);
    padding: 5rem 1.5rem;
  }

  .visao-cta {
    margin-top: 0;
    text-align: center;
  }

  .sobre-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.9rem 1.75rem;
    border: 1px solid var(--border-strong);
    color: var(--ink);
    transition:
      background-color 200ms ease,
      color 200ms ease,
      transform 160ms var(--ease-out);
  }

  .sobre-cta:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .sobre-cta:active {
    transform: scale(0.97);
  }

  @media (max-width: 64rem) {
    .hero {
      padding-block: 3rem 5rem;
    }

    .hero-grid {
      display: flex;
      flex-direction: column;
      gap: 3rem;
    }

    .hero-texto h1 {
      white-space: normal;
    }

    .linha-1 {
      white-space: normal;
    }

    .hero-retrato {
      max-width: 28rem;
    }

    .visao {
      padding-block: 5rem;
    }
  }
</style>
