---
import PageLayout from '../layouts/PageLayout.astro';
import { createReader } from '@keystatic/core/reader';
import keystaticConfig from '../../keystatic.config';
import { projetosImage } from '../lib/images';

const reader = createReader(process.cwd(), keystaticConfig);
const pagina = await reader.singletons.paginaProjetos.read();
const projetos = await reader.collections.projetos.all();

const cards = projetos.map(({ slug, entry }) => ({
  slug,
  numero: String(entry.ano ?? ''),
  categoria: entry.categoria,
  titulo: entry.titulo,
  local: entry.local ?? '',
  capa: projetosImage(entry.capa),
  largura: 736,
  altura: 552,
}));

const classes = ['p1', 'p2', 'p3', 'p4'];
cards.forEach((card, i) => (card.classe = classes[i % classes.length]));
---

<PageLayout title="Projetos — LUIZA TINOCO">
  <section class="hero">
    <h1>{pagina?.titulo}</h1>
    <p class="hero-sub">{pagina?.descricao}</p>
    <div class="filtros" role="group" aria-label="Filtrar projetos">
      {
        (pagina?.filtros ?? []).map((filtro, i) => (
          <button
            type="button"
            class:list={['label', 'filtro', { ativo: i === 0 }]}
            data-filtro={filtro.slug}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            {filtro.label}
          </button>
        ))
      }
    </div>
  </section>

  <section class="grid-section">
    <div class="grid" id="projetos-grid" data-reveal>
      {
        cards.map((p) => (
          <article class:list={['card', p.classe]} data-categoria={p.categoria}>
            <a href={`/projetos/${p.slug}`} class="card-imagem">
              <img
                src={p.capa}
                alt={p.titulo}
                width={p.largura}
                height={p.altura}
                loading="lazy"
              />
            </a>
            <div class="card-caption">
              <div class="card-texto">
                <span class="label card-categoria">
                  {p.numero} / {p.categoria}
                </span>
                <h2>{p.titulo}</h2>
              </div>
              {p.local && <span class="card-local">{p.local}</span>}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="moodboard">
    <div class="moodboard-grid" data-reveal>
      <div class="moodboard-texto">
        <div class="moodboard-divisor" aria-hidden="true"></div>
        <h2 class="moodboard-titulo">{pagina?.moodboardTitulo}</h2>
        <p>{pagina?.moodboardTexto}</p>
      </div>
      <div class="collage" aria-hidden="true">
        <div class="collage-bloco"></div>
        {pagina?.moodboardImagem1 && (
          <img
            src={projetosImage(pagina.moodboardImagem1)}
            alt=""
            class="collage-grande"
            loading="lazy"
          />
        )}
        {pagina?.moodboardImagem2 && (
          <img
            src={projetosImage(pagina.moodboardImagem2)}
            alt=""
            class="collage-quadrada"
            loading="lazy"
          />
        )}
      </div>
    </div>
  </section>

  <section class="cta">
    <h2>Vamos conversar sobre o<br />seu projeto?</h2>
    <a href="/contato" class="label cta-link">ENTRAR EM CONTATO</a>
  </section>
</PageLayout>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  function initFiltros() {
    const botoes = document.querySelectorAll<HTMLButtonElement>('.filtro');
    const cards = document.querySelectorAll<HTMLElement>('.card');
    const classes = ['p1', 'p2', 'p3', 'p4'];

    function relayout() {
      const visiveis = [...cards].filter((c) => c.style.display !== 'none');
      visiveis.forEach((card, i) => {
        card.classList.remove(...classes);
        card.classList.add(classes[i % classes.length]);
      });
    }

    function animarEntrada(mostrados: HTMLElement[]) {
      if (reduced.matches) return;
      mostrados.forEach((card, i) => {
        card.style.transition = 'none';
        card.style.opacity = '0';
        card.style.transform = 'scale(0.98)';
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            const delay = `${Math.min(i, 5) * 40}ms`;
            card.style.transition = `opacity 220ms var(--ease-out) ${delay}, transform 220ms var(--ease-out) ${delay}`;
            card.style.opacity = '';
            card.style.transform = '';
          });
        });
      });
    }

    botoes.forEach((botao) => {
      if (botao.dataset.filtroBound) return;
      botao.dataset.filtroBound = '1';

      botao.addEventListener('click', () => {
      botoes.forEach((b) => {
        b.classList.remove('ativo');
        b.setAttribute('aria-pressed', 'false');
      });
      botao.classList.add('ativo');
      botao.setAttribute('aria-pressed', 'true');

        const filtro = botao.dataset.filtro;
        const mostrados: HTMLElement[] = [];
        cards.forEach((card) => {
          const mostrar =
            filtro === 'todos' || card.dataset.categoria === filtro;
          card.style.display = mostrar ? '' : 'none';
          if (mostrar) mostrados.push(card);
        });

        relayout();
        animarEntrada(mostrados);
      });
    });
  }

  document.addEventListener('astro:page-load', initFiltros);
</script>

<style>
  /* Hero */
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 4rem 1.5rem 0;
    text-align: center;
  }

  .hero h1 {
    font-family: var(--font-h1);
    font-weight: 400;
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .hero-sub {
    margin-top: 1.5rem;
    max-width: 42rem;
    font-size: 1.125rem;
    line-height: 1.6;
    letter-spacing: 0.01em;
    color: var(--body-color);
  }

  .filtros {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    width: 100%;
    max-width: 70rem;
    margin-top: 4rem;
    padding-block: 1rem;
    border-block: 1px solid var(--accent);
  }

  .filtro {
    position: relative;
    padding: 0.5rem 0 3px;
    background: none;
    border: none;
    border-bottom: 1px solid transparent;
    color: var(--body-color);
    cursor: pointer;
    transition:
      color 150ms ease,
      border-color 150ms ease,
      transform 160ms var(--ease-out);
  }

  .filtro::after {
    content: '';
    position: absolute;
    inset: -8px -6px;
  }

  .filtro:hover {
    color: var(--ink);
  }

  .filtro:active {
    transform: scale(0.97);
  }

  .filtro.ativo {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  /* Grid assimétrico */
  .grid-section {
    max-width: 70rem;
    margin-inline: auto;
    padding: 8rem 1.5rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 2rem;
    row-gap: 4rem;
  }

  .card {
    display: flex;
    flex-direction: column;
  }

  .p1 {
    grid-column: 1 / span 8;
  }

  .p2 {
    grid-column: 9 / span 4;
    margin-top: 8rem;
  }

  .p3 {
    grid-column: 1 / span 5;
  }

  .p4 {
    grid-column: 7 / span 6;
    margin-top: 6rem;
  }

  .card-imagem {
    display: block;
    overflow: hidden;
    background: var(--surface);
  }

  .card-imagem img {
    width: 100%;
    height: auto;
    object-fit: cover;
    transition: transform 500ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .card-imagem:hover img {
      transform: scale(1.03);
    }
  }

  .card-caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 0.5rem 1rem;
    margin-top: 1.5rem;
  }

  .card-categoria {
    display: block;
    color: var(--muted);
    margin-bottom: 0.5rem;
  }

  .card-texto h2 {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.33;
    color: var(--ink);
  }

  .p1 .card-texto h2 {
    font-weight: 400;
    max-width: 36ch;
  }

  .card-local {
    flex-shrink: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--body-color);
  }

  /* Moodboard */
  .moodboard {
    background: var(--surface);
    padding: 10rem 1.5rem;
  }

  .moodboard-grid {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 4rem;
    max-width: 70rem;
    margin-inline: auto;
  }

  .moodboard-texto {
    align-self: center;
  }

  .moodboard-divisor {
    width: 3rem;
    height: 1px;
    background: var(--muted);
    margin-bottom: 2rem;
  }

  .moodboard-titulo {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.875rem, 3vw, 2.5rem);
    line-height: 1.25;
    color: var(--ink);
    white-space: pre-line;
  }

  .moodboard-texto p {
    margin-top: 1.75rem;
    max-width: 30ch;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--body-color);
  }

  /* Collage editorial */
  .collage {
    position: relative;
    aspect-ratio: 736 / 600;
  }

  .collage-bloco {
    position: absolute;
    left: 30%;
    top: 38%;
    width: 30%;
    height: 50%;
    background: var(--accent);
    border: 1px solid var(--accent);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  .collage img {
    position: absolute;
    object-fit: cover;
    border: 1px solid var(--accent);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  .collage-grande {
    left: 38%;
    top: 0;
    width: 62%;
    height: 92%;
  }

  .collage-quadrada {
    left: 0;
    top: 28%;
    width: 52%;
    height: 62%;
  }

  /* CTA */
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.3rem;
    padding: 8rem 1.5rem;
    text-align: center;
  }

  .cta h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .cta-link {
    padding-bottom: 8px;
    border-bottom: 1px solid var(--ink);
    color: var(--ink);
    transition: opacity 150ms ease;
  }

  .cta-link:hover {
    opacity: 0.7;
  }

  @media (max-width: 64rem) {
    .hero {
      padding-top: 3rem;
    }

    .grid-section,
    .moodboard {
      padding-block: 5rem;
    }

    .grid {
      display: flex;
      flex-direction: column;
      gap: 3rem;
    }

    .p2,
    .p4 {
      margin-top: 0;
    }

    .moodboard-grid {
      display: flex;
      flex-direction: column;
      gap: 3rem;
    }
  }
</style>
