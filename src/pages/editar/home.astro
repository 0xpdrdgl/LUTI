---
export const prerender = false
import EditarLayout from '../../layouts/EditarLayout.astro'
import './shared.css'
import { reader } from '../../lib/keystatic'
import { hasValidSession } from '../../lib/editarAuth'

const secret = import.meta.env.EDITAR_SESSION_SECRET
const authed = hasValidSession(Astro.request, secret)

const home = authed ? await reader.singletons.home.read() : null
---
<EditarLayout title="Home" authed={authed} active="home">
  {home && (
    <div class="editar-form-page">
      <div class="editar-page-header">
        <h1 class="editar-page-title">Página inicial</h1>
        <button type="button" id="editar-tour-restart" class="editar-tour-restart" title="Rever o tour guiado desta página">Ver tour</button>
      </div>
      <p class="editar-page-hint">Hero, sobre a autora, chamada, áreas de atuação, processo de trabalho e depoimentos.</p>

      <section class="editar-section">
        <h2>Hero e Projetos</h2>
        <div class="editar-field" id="f-heroImagem-field">
          <label class="editar-label">Imagem de fundo</label>
          <div class="editar-image-field">
            {home.heroImagem && <img src={home.heroImagem} alt="" class="editar-image-preview" />}
            <div class="editar-image-controls">
              <label class="editar-file-btn">
                Escolher imagem
                <input id="f-heroImagem" type="file" accept="image/*" hidden />
              </label>
              <span id="f-heroImagem-name" class="editar-file-name"></span>
            </div>
          </div>
        </div>
        <div class="editar-field">
          <label class="editar-label" for="f-heroTitulo">Título</label>
          <textarea id="f-heroTitulo" class="editar-textarea">{home.heroTitulo ?? ''}</textarea>
        </div>
        <div class="editar-field-row">
          <div class="editar-field">
            <label class="editar-label" for="f-heroBotaoLabel">Botão — texto</label>
            <input id="f-heroBotaoLabel" class="editar-input" type="text" value={home.heroBotaoLabel ?? ''} />
          </div>
          <div class="editar-field">
            <label class="editar-label" for="f-heroBotaoHref">Botão — link</label>
            <input id="f-heroBotaoHref" class="editar-input" type="text" value={home.heroBotaoHref ?? ''} />
          </div>
        </div>
        <div class="editar-field">
          <label class="editar-label" for="f-projetosNota">Projetos — observação (ex.: atuação em todo o Brasil)</label>
          <input id="f-projetosNota" class="editar-input" type="text" value={home.projetosNota ?? ''} />
        </div>
      </section>

      <section class="editar-section">
        <h2>Sobre a autora</h2>
        <div class="editar-field">
          <label class="editar-label" for="f-sobreTitulo">Título</label>
          <input id="f-sobreTitulo" class="editar-input" type="text" value={home.sobreTitulo ?? ''} />
        </div>
        <div class="editar-field" id="f-sobreFoto-field">
          <label class="editar-label">Foto</label>
          <div class="editar-image-field">
            {home.sobreFoto && <img src={home.sobreFoto} alt="" class="editar-image-preview" />}
            <div class="editar-image-controls">
              <label class="editar-file-btn">
                Escolher imagem
                <input id="f-sobreFoto" type="file" accept="image/*" hidden />
              </label>
              <span id="f-sobreFoto-name" class="editar-file-name"></span>
            </div>
          </div>
        </div>
        <div class="editar-field">
          <label class="editar-label">Textos</label>
          <div id="sobreParagrafos-list" class="editar-array-list">
            {(home.sobreParagrafos ?? []).map((p: string) => (
              <div class="editar-array-row" draggable="true">
                <span class="editar-drag-handle" title="Arraste para reordenar">⠿</span>
                <textarea class="editar-textarea" data-key="value">{p}</textarea>
                <button type="button" class="editar-array-remove">Remover</button>
              </div>
            ))}
          </div>
          <button type="button" id="sobreParagrafos-add" class="editar-array-add">+ Adicionar parágrafo</button>
        </div>
        <div class="editar-field-row" style="margin-top: 16px;">
          <div class="editar-field">
            <label class="editar-label" for="f-sobreLinkLabel">Link — texto</label>
            <input id="f-sobreLinkLabel" class="editar-input" type="text" value={home.sobreLinkLabel ?? ''} />
          </div>
          <div class="editar-field">
            <label class="editar-label" for="f-sobreLinkHref">Link — URL</label>
            <input id="f-sobreLinkHref" class="editar-input" type="text" value={home.sobreLinkHref ?? ''} />
          </div>
        </div>
      </section>

      <section class="editar-section">
        <h2>Chamada (CTA)</h2>
        <div class="editar-field">
          <label class="editar-label" for="f-ctaTitulo">Título</label>
          <textarea id="f-ctaTitulo" class="editar-textarea">{home.ctaTitulo ?? ''}</textarea>
        </div>
        <div class="editar-field-row">
          <div class="editar-field">
            <label class="editar-label" for="f-ctaLinkLabel">Link — texto</label>
            <input id="f-ctaLinkLabel" class="editar-input" type="text" value={home.ctaLinkLabel ?? ''} />
          </div>
          <div class="editar-field">
            <label class="editar-label" for="f-ctaLinkHref">Link — URL</label>
            <input id="f-ctaLinkHref" class="editar-input" type="text" value={home.ctaLinkHref ?? ''} />
          </div>
        </div>
      </section>

      <section class="editar-section">
        <h2>Áreas de atuação</h2>
        <div class="editar-field-row">
          <div class="editar-field">
            <label class="editar-label" for="f-areasTitulo">Título da seção</label>
            <input id="f-areasTitulo" class="editar-input" type="text" value={home.areasTitulo ?? ''} />
          </div>
          <div class="editar-field">
            <label class="editar-label" for="f-areasNota">Observação</label>
            <input id="f-areasNota" class="editar-input" type="text" value={home.areasNota ?? ''} />
          </div>
        </div>
        <div id="areas-list" class="editar-array-list">
          {(home.areas ?? []).map((area: any) => (
            <div class="editar-array-row editar-array-row-multi" draggable="true">
              <span class="editar-drag-handle" title="Arraste para reordenar">⠿</span>
              <div class="editar-array-row-fields">
                <input class="editar-input" type="text" placeholder="Título" value={area.titulo ?? ''} data-key="titulo" />
                <textarea class="editar-textarea" placeholder="Descrição" data-key="descricao">{area.descricao ?? ''}</textarea>
              </div>
              <button type="button" class="editar-array-remove">Remover</button>
            </div>
          ))}
        </div>
        <button type="button" id="areas-add" class="editar-array-add">+ Adicionar área</button>
      </section>

      <section class="editar-section">
        <h2>Processo de trabalho</h2>
        <div class="editar-field">
          <label class="editar-label" for="f-processoTitulo">Título da seção</label>
          <input id="f-processoTitulo" class="editar-input" type="text" value={home.processoTitulo ?? ''} />
        </div>
        <div id="processo-list" class="editar-array-list">
          {(home.processo ?? []).map((passo: any) => (
            <div class="editar-array-row editar-array-row-multi" draggable="true">
              <span class="editar-drag-handle" title="Arraste para reordenar">⠿</span>
              <div class="editar-array-row-fields">
                <input class="editar-input" type="text" placeholder="Título" value={passo.titulo ?? ''} data-key="titulo" />
                <textarea class="editar-textarea" placeholder="Descrição" data-key="descricao">{passo.descricao ?? ''}</textarea>
              </div>
              <button type="button" class="editar-array-remove">Remover</button>
            </div>
          ))}
        </div>
        <button type="button" id="processo-add" class="editar-array-add">+ Adicionar passo</button>
      </section>

      <section class="editar-section">
        <h2>Depoimentos</h2>
        <div class="editar-field">
          <label class="editar-label" for="f-depoimentosTitulo">Título da seção</label>
          <input id="f-depoimentosTitulo" class="editar-input" type="text" value={home.depoimentosTitulo ?? ''} />
        </div>
        <div id="depoimentos-list" class="editar-array-list">
          {(home.depoimentos ?? []).map((dep: any) => (
            <div class="editar-array-row editar-array-row-multi" draggable="true">
              <span class="editar-drag-handle" title="Arraste para reordenar">⠿</span>
              <div class="editar-array-row-fields">
                <input class="editar-input" type="text" placeholder="Nome" value={dep.nome ?? ''} data-key="nome" />
                <input class="editar-input" type="text" placeholder="Relação (ex.: Cliente, Ex-estagiária)" value={dep.relacao ?? ''} data-key="relacao" />
                <textarea class="editar-textarea" placeholder="Depoimento" data-key="texto">{dep.texto ?? ''}</textarea>
              </div>
              <button type="button" class="editar-array-remove">Remover</button>
            </div>
          ))}
        </div>
        <button type="button" id="depoimentos-add" class="editar-array-add">+ Adicionar depoimento</button>
      </section>

      <section class="editar-section">
        <h2>Faixa editorial</h2>
        <div class="editar-field">
          <label class="editar-label" for="f-faixaFrase">Frase</label>
          <textarea id="f-faixaFrase" class="editar-textarea">{home.faixaFrase ?? ''}</textarea>
        </div>
      </section>

      <footer class="editar-form-actions">
        <span id="editar-status" class="editar-status" role="status" aria-live="polite"></span>
        <button type="button" id="editar-save" class="editar-save">
          <span class="editar-save-label">Salvar alterações</span>
        </button>
      </footer>
    </div>
  )}
</EditarLayout>
<script>
  import { setStatus, makeTextRow, readTextArray, makeObjectRow, readObjectArray, enableDragReorder, updateImagePreview } from '../../lib/editarFormClient'
  import { maybeStartTour, startTour, type TourStep } from '../../lib/editarTour'

  const homeTourSteps: TourStep[] = [
    {
      selector: '.editar-topbar-inner',
      title: 'Página inicial',
      text: 'Essa é a página que aparece primeiro quando alguém entra no site. Ela tem 7 blocos, nessa ordem: Hero, Áreas de atuação, Sobre a autora, Faixa editorial, Processo de trabalho, Depoimentos e Chamada final. Vamos passar por cada um.',
    },
    {
      selector: '#f-heroImagem-field',
      title: 'Hero — imagem de fundo',
      text: 'A foto grande que ocupa a tela inteira assim que o site carrega. Clique em "Escolher imagem" pra trocar.',
    },
    {
      selector: '#f-heroTitulo',
      title: 'Hero — título',
      text: 'O texto grande em cima da foto. Pode usar quebra de linha (Enter) pra controlar onde o texto vira.',
    },
    {
      selector: '#f-heroBotaoLabel',
      title: 'Hero — botão',
      text: 'Texto e link do botão que aparece embaixo do título do Hero (normalmente leva pra página de Projetos).',
    },
    {
      selector: '#f-projetosNota',
      title: 'Observação sobre projetos',
      text: 'Essa frase pequena aparece logo abaixo do título do Hero — normalmente usada pra dizer onde vocês atendem (ex: "Projetos em todo o Brasil").',
    },
    {
      selector: '#areas-list',
      title: 'Áreas de atuação',
      text: 'Lista numerada dos tipos de projeto que vocês fazem (ex: Residencial, Comercial). Cada item tem um título e uma descrição curta. Arraste pelo ⠿ pra reordenar, ou clique em "+ Adicionar área" pra criar um novo.',
    },
    {
      selector: '#f-sobreFoto-field',
      title: 'Sobre a autora — foto',
      text: 'Foto da Luiza que aparece ao lado do texto de apresentação, mais abaixo na home.',
    },
    {
      selector: '#sobreParagrafos-list',
      title: 'Sobre a autora — texto',
      text: 'Esse é um resumo curto da autora (a biografia completa fica na página /sobre, editável em "Página Sobre"). Arraste pelo ⠿ pra reordenar os parágrafos, ou adicione mais um.',
    },
    {
      selector: '#f-sobreLinkLabel',
      title: 'Sobre a autora — link',
      text: 'Texto e destino do link que aparece depois do texto (ex: "CONHEÇA A AUTORA" apontando pra /sobre).',
    },
    {
      selector: '#f-faixaFrase',
      title: 'Faixa editorial',
      text: 'Uma frase de destaque, sozinha numa faixa da página, entre a seção "Sobre a autora" e "Processo" — funciona como uma pausa visual.',
    },
    {
      selector: '#processo-list',
      title: 'Processo de trabalho',
      text: 'As etapas do processo de trabalho de vocês, numeradas na ordem em que acontecem (ex: Briefing, Anteprojeto, Projeto Executivo...). Arraste pelo ⠿ pra reordenar.',
    },
    {
      selector: '#depoimentos-list',
      title: 'Depoimentos',
      text: 'Depoimentos de clientes ou colaboradores. Cada um tem nome, relação (ex: "Cliente", "Ex-estagiária") e o texto do depoimento. Só aparece no site se tiver pelo menos um cadastrado.',
    },
    {
      selector: '#f-ctaTitulo',
      title: 'Chamada final (CTA)',
      text: 'O último bloco da home, antes do rodapé — um convite direto pra entrar em contato, com título e botão.',
    },
    {
      selector: '#editar-save',
      title: 'Salvar',
      text: 'Nada é salvo automaticamente. Depois de editar qualquer coisa nessa página, clique aqui — e só saia da página depois de ver a confirmação de que salvou.',
    },
  ]
  const HOME_TOUR_KEY = 'editar_tour_home_seen'
  maybeStartTour(homeTourSteps, HOME_TOUR_KEY)
  document.getElementById('editar-tour-restart')?.addEventListener('click', () => startTour(homeTourSteps, HOME_TOUR_KEY))

  enableDragReorder(document.getElementById('sobreParagrafos-list') as HTMLDivElement, '.editar-array-row')
  enableDragReorder(document.getElementById('areas-list') as HTMLDivElement, '.editar-array-row')
  enableDragReorder(document.getElementById('processo-list') as HTMLDivElement, '.editar-array-row')
  enableDragReorder(document.getElementById('depoimentos-list') as HTMLDivElement, '.editar-array-row')

  document.getElementById('sobreParagrafos-add')?.addEventListener('click', () => {
    document.getElementById('sobreParagrafos-list')?.appendChild(makeTextRow('', 'Parágrafo'))
  })
  document.getElementById('areas-add')?.addEventListener('click', () => {
    document.getElementById('areas-list')?.appendChild(
      makeObjectRow([
        { key: 'titulo', type: 'text', placeholder: 'Título' },
        { key: 'descricao', type: 'textarea', placeholder: 'Descrição' },
      ])
    )
  })
  document.getElementById('processo-add')?.addEventListener('click', () => {
    document.getElementById('processo-list')?.appendChild(
      makeObjectRow([
        { key: 'titulo', type: 'text', placeholder: 'Título' },
        { key: 'descricao', type: 'textarea', placeholder: 'Descrição' },
      ])
    )
  })
  document.getElementById('depoimentos-add')?.addEventListener('click', () => {
    document.getElementById('depoimentos-list')?.appendChild(
      makeObjectRow([
        { key: 'nome', type: 'text', placeholder: 'Nome' },
        { key: 'relacao', type: 'text', placeholder: 'Relação (ex.: Cliente, Ex-estagiária)' },
        { key: 'texto', type: 'textarea', placeholder: 'Depoimento' },
      ])
    )
  })
  document.body.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.editar-array-remove') as HTMLButtonElement | null
    if (btn) btn.closest('.editar-array-row')?.remove()
  })

  function bindImagePicker(fieldId: string) {
    let file: File | null = null
    const input = document.getElementById(`f-${fieldId}`) as HTMLInputElement | null
    const nameEl = document.getElementById(`f-${fieldId}-name`) as HTMLSpanElement | null
    input?.addEventListener('change', () => {
      const f = input.files?.[0]
      if (!f) return
      file = f
      if (nameEl) nameEl.textContent = f.name
    })
    return () => file
  }
  const getHeroImagem = bindImagePicker('heroImagem')
  const getSobreFoto = bindImagePicker('sobreFoto')

  const saveBtn = document.getElementById('editar-save') as HTMLButtonElement
  const statusEl = document.getElementById('editar-status') as HTMLSpanElement

  saveBtn.addEventListener('click', async () => {
    saveBtn.disabled = true
    saveBtn.classList.add('is-loading')
    setStatus(statusEl, 'Salvando...')

    try {
      const val = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement)?.value ?? ''

      const fields = {
        heroTitulo: val('f-heroTitulo'),
        heroBotaoLabel: val('f-heroBotaoLabel'),
        heroBotaoHref: val('f-heroBotaoHref'),
        projetosNota: val('f-projetosNota'),
        sobreTitulo: val('f-sobreTitulo'),
        sobreParagrafos: readTextArray('sobreParagrafos-list'),
        sobreLinkLabel: val('f-sobreLinkLabel'),
        sobreLinkHref: val('f-sobreLinkHref'),
        ctaTitulo: val('f-ctaTitulo'),
        ctaLinkLabel: val('f-ctaLinkLabel'),
        ctaLinkHref: val('f-ctaLinkHref'),
        areasTitulo: val('f-areasTitulo'),
        areasNota: val('f-areasNota'),
        areas: readObjectArray('areas-list', ['titulo', 'descricao']),
        processoTitulo: val('f-processoTitulo'),
        processo: readObjectArray('processo-list', ['titulo', 'descricao']),
        depoimentosTitulo: val('f-depoimentosTitulo'),
        depoimentos: readObjectArray('depoimentos-list', ['nome', 'relacao', 'texto']),
        faixaFrase: val('f-faixaFrase'),
      }

      const formData = new FormData()
      formData.set('singleton', 'home')
      formData.set('fields', JSON.stringify(fields))
      const heroImagem = getHeroImagem()
      const sobreFoto = getSobreFoto()
      if (heroImagem) formData.set('image__heroImagem', heroImagem)
      if (sobreFoto) formData.set('image__sobreFoto', sobreFoto)

      const res = await fetch('/api/editar-singleton', { method: 'POST', body: formData })
      const data = await res.json()
      if (!res.ok) throw new Error(data.error || 'Erro ao salvar')

      // Não recarrega a página: em produção ela leria do último deploy, que
      // ainda não tem o que acabou de ser salvo (o site republica sozinho em
      // segundo plano, mas leva alguns segundos). Atualiza a tela na hora com
      // o que o servidor confirmou ter gravado.
      updateImagePreview('f-heroImagem-field', data.data?.heroImagem)
      updateImagePreview('f-sobreFoto-field', data.data?.sobreFoto)
      setStatus(statusEl, 'Salvo com sucesso!', 'success')
    } catch (err) {
      setStatus(statusEl, err instanceof Error ? err.message : 'Erro ao salvar', 'error')
    } finally {
      saveBtn.disabled = false
      saveBtn.classList.remove('is-loading')
    }
  })
</script>
